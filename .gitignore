# 虚拟环境（体积大，不入库）
.venv/

# Python 缓存
__pycache__/
*.py[cod]

# Node 依赖
node_modules/

# 含 API Key 的本地配置，不要提交
config.json

# Electron 版运行时数据（含 API Key、提醒队列、调试日志）
.data/

# electron-builder 产物
dist/

# 临时截图 / 调试产物
.workbuddy/tmp/

# AI 助手工作目录（记忆、调试脚本），不属于项目本身
.workbuddy/

# NapCat 协议端（1GB+ 独立 QQ 内核，官方下载即可，不入库）
qq-bot/napcat/
qq-bot/*.zip

# 本地工具二进制（ffmpeg 变声用）
tools/ffmpeg/

# ---- 微信机器人（wechat-bot/，UI 自动化）----
# 自带 Python 运行时（几十 MB，装一次即可，不入库）
wechat-bot/py312/
# 合成语音与临时产物
wechat-bot/tts/
# 运行日志 / 状态 / 调试截图
wechat-bot/*.log
wechat-bot/*.jsonl
wechat-bot/bot-state.json
wechat-bot/bot-db-state.json
wechat-bot/_*.png
wechat-bot/*-src.png
# 探测过程的临时截图（表情面板标定等）
wechat-bot/_probe/
wechatauto_logs/
# uiautomation 库自己往工作目录写的自动化日志、临时备份、运行时压缩包
wechat-bot/@AutomationLog.txt
wechat-bot/*.bak
wechat-bot/*.zip
# 含登录账号 / 本地绝对路径的配置，不入库
wechat-bot/bot-config.json
wechat-bot/bot-db-config.json
# 企业微信机器人：含 CorpID / Secret
wecom-bot/config.json
wecom-bot/*.log

# 主动发消息的配额状态（运行态）
wechat-bot/proactive-state.json
